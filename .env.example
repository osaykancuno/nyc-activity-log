# ─────────────────────────────────────────────────────────────
#  NYC ACTIVITY LOG — configuration
#  Copy this file to .env and fill it in. Nothing here is secret
#  until you add the X keys; the bot runs read-only without them.
# ─────────────────────────────────────────────────────────────

# 1) SAFETY ───────────────────────────────────────────────────
# true  = render + print posts to ./out, never touch X   (start here)
# false = actually post
DRY_RUN=true

# 2) CHAIN ────────────────────────────────────────────────────
# A dedicated RPC is strongly recommended (Alchemy / QuickNode free tier).
# Leave as-is to use a public endpoint: fine for testing, flaky for production.
RPC_URL=https://ethereum-rpc.publicnode.com
# Optional second RPC, used automatically if the first fails.
RPC_URL_FALLBACK=https://eth.llamarpc.com

# Where to begin reading. "latest" = only new events (default, recommended).
# A block number = backfill from there (e.g. 25514828 = deploy block).
START_BLOCK=latest
# Blocks to wait before trusting an event (reorg safety).
CONFIRMATIONS=3
# How often to poll for new blocks, milliseconds.
POLL_INTERVAL_MS=20000
# Widest eth_getLogs window. Public nodes cap this; the bot narrows it by itself
# when a provider refuses, and widens it again when it stops refusing.
MAX_BLOCK_SPAN=400

# Optional: the Normies contract, to publish the burned count in the watch.
# Leave empty and the watch reports fleet size from the club API instead.
NORMIES_CONTRACT=

# 3) MODULES  (a module with no data source stays off. It never simulates.)
MODULE_CLAIM=true          # A — Transfer from 0x0
MODULE_SALE=true           # B — Transfer + marketplace payment
MODULE_SWEEP=true          # C — N hulls, same buyer, same tx
MODULE_LOOKUP=false        # D — mention + #id  (needs X read access; the free tier has none)
MODULE_WATCH=true          # E — cron 05:30 / 18:30 UTC
MODULE_PEDIGREE=true       # F — CLI / on request
MODULE_TIDE=true           # G — rounds opening and settling, from the club relay
MODULE_CHANDLERY=false     # H — stays off: purchases are only exposed per wallet, and
                           #     this log does not harvest wallets. See README.
MODULE_FORGE=auto          # I — auto = follow the relay's own forge phase (recommended).
                           #     true forces it on, false off.
MODULE_JOURNAL=true        # J — Yoko's own entry, once a day, in her voice

# The club's own relay: the public service the marina itself reads.
# Fleet-wide and hull-keyed routes only; the wallet-keyed ones are never called.
RELAY_URL=https://nyc-realtime.fly.dev
TIDE_POLL_MS=300000
FORGE_POLL_MS=900000

# 4) EDITORIAL ────────────────────────────────────────────────
# Where the picture comes from. 'chain' = tokenURI, the official immutable image
# (recommended: for a couple of hulls the API snapshot and the contract disagree).
# 'api' = the CDN bitmap, one RPC call cheaper.
ART_SOURCE=chain

# Do not post sales below this (in ETH). 0 = post everything.
MIN_SALE_ETH=0
# A sweep is N or more hulls to the same buyer in one tx.
SWEEP_MIN=2
# Cron for the two watches (UTC).
WATCH_CRON_MORNING=30 5 * * *
WATCH_CRON_EVENING=30 18 * * *

# The keeper of the log: Yoko, ERC-8004 agent #32683, bound to Normie #8362.
# Her record supplies numbers only - canvas level, action points, passes, the
# pixel diff. Every sentence she can publish is in data/yoko.json, in the repo.
AGENT_API=https://api.normies.art/agents
AGENT_REFRESH_H=6
# When she writes her entry (UTC). End of the first watch: the day is done.
JOURNAL_CRON=45 21 * * *
# Write an entry even on a day when nothing at all happened. Quiet is a reading
# too - and it is what makes the account a diary rather than an alert feed.
JOURNAL_ON_QUIET_DAYS=true

# 5) RATE / BUDGET ────────────────────────────────────────────
# Minimum seconds between two posts.
POST_MIN_INTERVAL_S=20

# X bills per request: $0.015 a post, and $0.200 if the post contains a URL
# (the bot refuses to publish one, on purpose). Reads of your own mentions are
# $0.001 each. Buy credits in the developer console and set a spending limit there
# too - this ceiling is the bot's own, and it is the one that stops it quietly.
# X adds its own t.co link when an image is attached. If the console shows a post
# with a card billed at $0.200 instead of $0.015, set this to false: the log keeps
# working, text only, at the cheap rate.
ATTACH_MEDIA=true

MONTHLY_BUDGET_USD=5
COST_PER_POST_USD=0.015
# Below this much left, only claims, sweeps, forges and settled Tide rounds go out.
BUDGET_RESERVE_USD=1

# Second fence, in posts rather than dollars.
MAX_POSTS_PER_MONTH=450
BUDGET_RESERVE=40

# 6) X / TWITTER  (leave empty while DRY_RUN=true) ────────────
# From developer.x.com -> your app -> Keys and tokens.
# The app MUST be set to Read and Write BEFORE you generate the access token.
X_APP_KEY=
X_APP_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Numeric user id of the bot account (used for mentions). Leave empty if unknown.
X_USER_ID=

# 7) MISC ─────────────────────────────────────────────────────
# Where the dedup ledger and the block cursor live. On a host with ephemeral
# disks, point this at a mounted volume or the bot will repost after a redeploy.
STATE_DIR=

# Health endpoint port (Railway/Fly like this). 0 = disabled.
HEALTH_PORT=0
LOG_LEVEL=info
